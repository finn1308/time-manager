# ==============================================================================
# CHRONOMIND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in the appropriate secrets before starting.
# DO NOT commit real secrets or credentials into version control!
# ==============================================================================

# 1. DATABASE CONNECTION
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL / Supabase Transaction Pooler port 6543 or Session port 5432):
# DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# 2. SUPABASE INTEGRATION (Optional - if using Supabase client directly)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-private-key"

# 3. AUTHENTICATION (NextAuth / JWT session cookie)
# Generate a secure 32+ character random string: openssl rand -base64 32
AUTH_SECRET="your-32-character-random-secret-key-goes-here"
NEXTAUTH_URL="http://localhost:3000"

# 4. DATA ENCRYPTION (AES-256-GCM for user AI API Keys)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 5. APPLICATION TIMEZONE
NEXT_PUBLIC_APP_TIMEZONE="Asia/Ho_Chi_Minh"

# 6. GOOGLE OAUTH CREDENTIALS (Optional - for Google Sign-in)
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-google-oauth-client-secret"
