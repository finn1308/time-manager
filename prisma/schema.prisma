datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String         @default("USER") // USER, ADMIN
  timezone      String         @default("Asia/Ho_Chi_Minh")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts      Account[]
  sessions      Session[]
  userApiKeys   UserApiKey[]
  subjects      Subject[]
  studyGoals    StudyGoal[]
  schedules     ScheduleEvent[]
  studyLogs     StudyLog[]
  blockedSlots  BlockedSlot[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// AES-256-GCM encrypted API key storage
model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // OPENAI, GEMINI, ANTHROPIC
  encryptedKey String
  iv           String   // Initialization Vector (hex)
  authTag      String   // Auth Tag (hex)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider])
}

model Subject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  code        String?  // e.g. CS101, MATH201
  color       String   @default("#3b82f6") // Pastel HEX color
  icon        String?  // Icon name or Emoji
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGoals  StudyGoal[]
  schedules   ScheduleEvent[]
  studyLogs   StudyLog[]
}

model StudyGoal {
  id          String    @id @default(cuid())
  userId      String
  subjectId   String
  targetHours Float     // Target hours
  startDate   DateTime
  endDate     DateTime
  isAutoAlloc Boolean   @default(true)
  priority    Int       @default(1) // 1 (Low) -> 5 (High)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model BlockedSlot {
  id           String    @id @default(cuid())
  userId       String
  title        String
  startTime    String    // Format "HH:mm" e.g. "07:30"
  endTime      String    // Format "HH:mm" e.g. "11:30"
  dayOfWeek    Int?      // 0 (Sunday) to 6 (Saturday)
  specificDate DateTime?
  isRecurring  Boolean   @default(true)
  isLocked     Boolean   @default(true) // AI must avoid this slot
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduleEvent {
  id            String    @id @default(cuid())
  userId        String
  subjectId     String?
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  eventType     String    @default("STUDY") // STUDY, BUSY_BLOCKED, FIXED_CLASS, PERSONAL
  isAiGenerated Boolean   @default(false)
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  studyLogs StudyLog[]
}

model StudyLog {
  id                String         @id @default(cuid())
  userId            String
  subjectId         String
  scheduleEventId   String?
  startTime         DateTime
  endTime           DateTime
  durationMinutes   Int
  notes             String?
  productivityScore Int?         // 1 to 5
  source            String         @default("PIP_TIMER") // PIP_TIMER, MANUAL, STOPWATCH
  createdAt         DateTime       @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scheduleEvent ScheduleEvent? @relation(fields: [scheduleEventId], references: [id], onDelete: SetNull)
}
