  @@index([userId])
  @@index([calendarEventId])
  @@index([subjectId])
  @@index([skillId])
}

model StudyNote {
  id              String         @id @default(cuid())
  userId          String
  calendarEventId String?
  subjectId       String?
  content         String         @db.Text
  isPinned        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([calendarEventId])
  @@index([subjectId])
}

// ==============================================================================
// 4-YEAR ACADEMIC OPERATING SYSTEM MODELS
// ==============================================================================

model DegreeProgram {
  id                   String   @id @default(cuid())
  userId               String   @unique
  major                String   @default("Công nghệ Thông tin")
  faculty              String?  @default("Khoa CNTT")
  university           String?  @default("Đại học")
  totalCreditsRequired Int      @default(130)
  targetGpa            Float    @default(3.6)
  currentGpa           Float    @default(0.0)
  currentCredits       Int      @default(0)
  graduationYear       Int?
  status               String   @default("ACTIVE") // ACTIVE, GRADUATED, ON_HOLD
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AcademicYear {
  id         String   @id @default(cuid())
  userId     String
  yearNumber Int      @default(1) // 1, 2, 3, 4, 5...
  name       String   // e.g. "Năm 1", "Năm 2", "Năm học 2024 - 2025"
  startDate  DateTime
  endDate    DateTime
  status     String   @default("ACTIVE") // PLANNED, ACTIVE, COMPLETED, ARCHIVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesters Semester[]

  @@unique([userId, yearNumber])
  @@index([userId])
}

model Semester {
  id             String   @id @default(cuid())
  userId         String
  academicYearId String
  name           String   // e.g. "Học kỳ 1", "Học kỳ 2", "Học kỳ Hè"
  type           String   @default("FALL") // FALL, SPRING, SUMMER, CUSTOM
  startDate      DateTime
  endDate        DateTime
  status         String   @default("ACTIVE") // PLANNED, ACTIVE, COMPLETED, ARCHIVED
  gpa10          Float?
  gpa4           Float?
  totalCredits   Int      @default(0)
  earnedCredits  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subjects     Subject[]
  assignments  Assignment[]

  @@index([userId, status])
  @@index([academicYearId])
}

model Skill {
  id          String   @id @default(cuid())
  userId      String
  name        String
  category    String   @default("TECH") // TECH, LANGUAGE, SOFT, DESIGN, OTHER
  level       String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  description String?  @db.Text
  
  // Ultra Learning Fields
  targetLevel            String?
  status                 String   @default("NOT_STARTED") // NOT_STARTED, LEARNING, PAUSED, COMPLETED
  totalPlannedHours      Int?     @default(0)
  totalActualHours       Int?     @default(0)
  weeklyHoursCommitment  Int?     @default(0)
  deadline               DateTime?
  specificGoal           String?  @db.Text
  knowledgeMap           Json?    // Stores the AI-generated domain/subskill structure
  learningStrategy       Json?    // Stores the Metalearning strategy
  progressPercentage     Int?     @default(0)
  currentStreak          Int?     @default(0)
  nextRecommendedAction  String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       ProjectSkill[]
  phases         SkillPhase[]
  calendarEvents CalendarEvent[]
  studySessions  StudySession[]
  resources      Resource[]
  flexibleGoals  FlexibleStudyGoal[]

  @@unique([userId, name])
  @@index([userId])
}

model SkillPhase {
  id              String   @id @default(cuid())
  skillId         String
  name            String
  description     String?  @db.Text
  order           Int      @default(0)
  status          String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  plannedHours    Int      @default(0)
  actualHours     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skill           Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  units           SkillUnit[]
}

model SkillUnit {
  id              String   @id @default(cuid())
  phaseId         String
  name            String
  description     String?  @db.Text
  order           Int      @default(0)
  status          String   @default("NOT_STARTED")
  plannedMinutes  Int      @default(0)
  actualMinutes   Int      @default(0)
  masteryLevel    Int      @default(0) // 0-100
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phase           SkillPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  tasks           SkillTask[]
}

model SkillTask {
  id              String   @id @default(cuid())
  unitId          String
  name            String
  description     String?  @db.Text
  taskType        String   @default("PRACTICE") // THEORY, PRACTICE, DRILL, RETRIEVAL, FEEDBACK, PROJECT
  order           Int      @default(0)
  status          String   @default("NOT_STARTED")
  plannedMinutes  Int      @default(30)
  actualMinutes   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unit            SkillUnit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assessments     SkillAssessment[]
  calendarEvents  CalendarEvent[]
  studySessions   StudySession[]
}

model SkillAssessment {
  id              String   @id @default(cuid())
  taskId          String
  score           Int?     // 0-100
  feedback        String?  @db.Text
  weaknesses      Json?    // Weak points identified
  strengths       Json?
  createdAt       DateTime @default(now())

  task            SkillTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Project {
  id            String    @id @default(cuid())
  userId        String
  subjectId     String?
  title         String
  description   String?   @db.Text
  repositoryUrl String?
  demoUrl       String?
  technologies  String?   // Comma-separated or tags
  status        String    @default("IN_PROGRESS") // PLANNED, IN_PROGRESS, COMPLETED, FEATURED
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  skills  ProjectSkill[]

  @@index([userId])
  @@index([subjectId])
}

model ProjectSkill {
  projectId String
  skillId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model Certificate {
  id            String    @id @default(cuid())
  userId        String
  name          String
  issuer        String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String?
  score         String?
  status        String    @default("ACTIVE") // ACTIVE, EXPIRED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CareerApplication {
  id          String    @id @default(cuid())
  userId      String
  company     String
  role        String
  location    String?
  type        String    @default("INTERNSHIP") // INTERNSHIP, PART_TIME, FULL_TIME
  status      String    @default("APPLIED") // SAVED, APPLIED, INTERVIEW, OFFER, REJECTED, WITHDRAWN
  appliedDate DateTime?
  deadline    DateTime?
  salary      String?
  notes       String?   @db.Text
  jobUrl      String?
  resumeUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  entityType  String   // CALENDAR_EVENT, SUBJECT, GRADE, SEMESTER, TASK, NOTE
  entityId    String
  action      String   // CREATE, UPDATE, DELETE, RESTORE, ARCHIVE, TRANSITION
  detailsJson String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType, createdAt])
}

// ==============================================================================
// LUYENTU - VOCABULARY PLATFORM MODELS
// ==============================================================================

model VocabCourse {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String   // e.g. "A1 (0-3.0)"
  subtitle    String?  // e.g. "Dành cho người mới bắt đầu học tiếng anh"
  description String?  @db.Text
  icon        String?  @default("📚")
  coverColor  String?  @default("#10b981")
  level       String   @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  isPublished Boolean  @default(true)
  isPro       Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  wordSets    WordSet[]
  enrollments UserCourseEnrollment[]

  @@index([isPublished, order])
  @@index([subjectId])
}

model WordSet {
  id          String   @id @default(cuid())
  courseId    String
  orderNumber Int      // 1, 2, 3, 4...
  title       String   // e.g. "Lời chào hỏi", "Số đếm", "Màu sắc"
  description String?  @db.Text
  icon        String?
  isPro       Boolean  @default(false) // PRO lock badge
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjectId   String?
  course         VocabCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject        Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  words          VocabWord[]
  userProgresses UserWordSetProgress[]
  studySessions  VocabStudySession[]

  @@unique([courseId, orderNumber])
  @@index([courseId])
  @@index([subjectId])
}

model VocabWord {
  id              String   @id @default(cuid())
  wordSetId       String
  term            String   // English word: "Hello", "Good morning"
  phonetic        String?  // IPA: "/həˈləʊ/"
  partOfSpeech    String?  // noun, verb, adjective, phrase, interjection
  meaning         String   // Vietnamese: "Xin chào"
  explanation     String?  @db.Text
  exampleSentence String?  @db.Text // "Hello, nice to meet you!"
  exampleMeaning  String?  @db.Text // "Xin chào, rất vui được gặp bạn!"
  audioUrl        String?
  imageUrl        String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subjectId       String?
  difficulty      String?  @default("B1")
  topic           String?  @default("General English")

  wordSet        WordSet                 @relation(fields: [wordSetId], references: [id], onDelete: Cascade)
  subject        Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  userProgress   UserWordProgress[]
  masteryRecords UserVocabularyMastery[]
  learningEvents LearningEvent[]

  @@index([wordSetId, order])
  @@index([subjectId])
}

model UserCourseEnrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  isPinned    Boolean  @default(false) // Pin button from image: "📌 Đã ghim"
  isUnlocked  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course VocabCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model UserWordSetProgress {
  id             String   @id @default(cuid())
  userId         String
  wordSetId      String
  isUnlocked     Boolean  @default(false)
  completedWords Int      @default(0)
  totalWords     Int      @default(0)
  isMastered     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordSet WordSet @relation(fields: [wordSetId], references: [id], onDelete: Cascade)

  @@unique([userId, wordSetId])
  @@index([userId])
}

model UserWordProgress {
  id              String    @id @default(cuid())
  userId          String
  wordId          String
  wordSetId       String
  status          String    @default("NEW") // "NEW" (chưa học), "LEARNING" (chưa thuộc), "MASTERED" (đã thuộc)
  isFavorite      Boolean   @default(false)
  timesStudied    Int       @default(0)
  correctCount    Int       @default(0)
  incorrectCount  Int       @default(0)

  // SuperMemo SM-2 Spaced Repetition (Học ngắt quãng)
  repetition      Int       @default(0)
  intervalDays    Int       @default(1)
  easeFactor      Float     @default(2.5)
  nextReviewDate  DateTime?
  lastReviewedAt  DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, status])
  @@index([userId, wordSetId])
  @@index([userId, nextReviewDate])
}

model VocabStudySession {
  id              String   @id @default(cuid())
  userId          String
  wordSetId       String
  mode            String   // FLASHCARD, QUIZ, LISTENING, TYPING, MATCHING, SPECIAL
  totalItems      Int      @default(0)
  correctItems    Int      @default(0)
  accuracy        Float    @default(0)
  durationSeconds Int      @default(0)
  coinsEarned     Int      @default(0)
  xpEarned        Int      @default(0)
  createdAt       DateTime @default(now())

  subjectId       String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordSet WordSet  @relation(fields: [wordSetId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([subjectId])
}

model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String
  type        String   // PRO_UNLOCK, STREAK_FREEZE, AVATAR, BADGE, THEME
  costCoins   Int
  icon        String?
  metadata    String?  // JSON
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchases   UserPurchase[]
}

model UserPurchase {
  id         String   @id @default(cuid())
  userId     String
  shopItemId String
  costPaid   Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==============================================================================
// LUYENTU - AI-POWERED ADAPTIVE LEARNING ENGINE MODELS
// ==============================================================================

model UserVocabularyMastery {
  id                   String    @id @default(cuid())
  userId               String
  vocabularyId         String

  // Continuous knowledge & confidence scores (0.0 to 1.0)
  knowledgeScore       Float     @default(0.0)
  confidenceScore      Float     @default(0.0)

  // Behavioral signals
  totalAttempts        Int       @default(0)
  correctAttempts      Int       @default(0)
  incorrectAttempts    Int       @default(0)
  consecutiveCorrect   Int       @default(0)
  consecutiveIncorrect Int       @default(0)
  averageResponseTime  Float     @default(0.0) // seconds

  // Temporal signals
  lastSeenAt           DateTime?
  lastCorrectAt        DateTime?
  lastIncorrectAt      DateTime?

  // Forgetting & dynamic difficulty
  forgettingRisk       Float     @default(0.0) // 0.0 (safe) -> 1.0 (imminent forgetting)
  difficultyScore      Float     @default(0.5) // 0.1 (very easy) -> 1.0 (very hard)
  memoryStability      Float     @default(1.0) // stability factor S in half-life model (in days)
  nextReviewAt         DateTime?

  // Cross-skill mastery breakdown (0.0 to 1.0)
  recognitionScore     Float     @default(0.0) // EN -> VN
  recallScore          Float     @default(0.0) // VN -> EN
  spellingScore        Float     @default(0.0) // Typing word
  listeningScore       Float     @default(0.0) // Audio identification
  usageScore           Float     @default(0.0) // Contextual / sentence usage

  // AI Cognitive analysis fields
  aiAnalysisNotes      String?   @db.Text
  lastAiAnalyzedAt     DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary VocabWord @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId, knowledgeScore])
  @@index([userId, forgettingRisk])
  @@index([userId, nextReviewAt])
  @@index([vocabularyId])
}

model LearningEvent {
  id              String    @id @default(cuid())
  userId          String
  vocabularyId    String

  eventType       String    // VIEW, ANSWER_CORRECT, ANSWER_INCORRECT, SKIPPED, FLASHCARD_REVIEW, QUIZ_COMPLETED, MANUAL_MARK_KNOWN, MANUAL_MARK_UNKNOWN
  answer          String?   @db.Text
  isCorrect       Boolean
  responseTime    Float?    // response duration in seconds
  questionType    String?   // RECOGNITION, RECALL, SENTENCE_COMPLETION, LISTENING, SPELLING, MATCHING
  difficulty      Float?    // 0.1 - 1.0

  previousMastery Float?
  newMastery      Float?
  metadata        String?   @db.Text // JSON metadata

  createdAt       DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary VocabWord @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, eventType])
  @@index([vocabularyId])
}

model UserAiLearningReport {
  id                    String    @id @default(cuid())
  userId                String

  strongestArea         String
  weakestArea           String
  wordsNeedingAttention String    @db.Text // JSON string
  wordsImprovingRapidly String    @db.Text // JSON string
  recommendedFocus      String    @db.Text
  cognitiveInsights     String?   @db.Text
  providerUsed          String?

  createdAt             DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ==============================================================================
// 4-YEAR UNIVERSITY MASTER LEARNING OS EXPANSION MODELS
// ==============================================================================

model UserLearningMemory {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  overallLevel             String   @default("INTERMEDIATE")
  strengthsJson            String   @default("[]") @db.Text
  weaknessesJson           String   @default("[]") @db.Text
  retentionRate            Float    @default(0.8)
  learningSpeed            Float    @default(1.0)
  preferredDurationMins    Int      @default(45)
  preferredTimeOfDay       String   @default("EVENING") // MORNING, AFTERNOON, EVENING, NIGHT
  frequentMistakeTypesJson String   @default("[]") @db.Text
  subjectMasteryJson       String   @default("{}") @db.Text
  retentionRatesJson       String   @default("{}") @db.Text
  cognitiveSummary         String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MistakeRecord {
  id              String    @id @default(cuid())
  userId          String
  subjectId       String?
  sourceType      String    // QUIZ, EXAM, FLASHCARD, TYPING, PRACTICE, AI_SESSION, DOCUMENT
  sourceId        String?
  question        String    @db.Text
  correctAnswer   String    @db.Text
  userAnswer      String    @db.Text
  concept         String?
  topic           String?
  errorType       String    @default("KNOWLEDGE_GAP") // KNOWLEDGE_GAP, MISUNDERSTANDING, CARELESS, MEMORY_FAILURE, CALCULATION, VOCABULARY, CONCEPT_CONFUSION
  difficulty      String    @default("MEDIUM") // EASY, MEDIUM, HARD
  repetitionCount Int       @default(1)
  masteryLevel    Int       @default(0) // 0 to 5
  isResolved      Boolean   @default(false)
  nextReviewDate  DateTime?
  lastReviewedAt  DateTime?
  explanation     String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, isResolved])
  @@index([userId, nextReviewDate])
  @@index([subjectId])
}

model ExamPreparation {
  id                  String    @id @default(cuid())
  userId              String
  subjectId           String?
  title               String
  examDate            DateTime
  targetScore         Float     @default(8.5)
  currentScore        Float     @default(5.0)
  availableStudyHours Float     @default(40.0)
  currentPhase        String    @default("FOUNDATION") // FOUNDATION, WEAK_TOPIC_RECOVERY, PRACTICE, MOCK_EXAM, FINAL_REVIEW
  readinessScore      Float     @default(0.0) // 0 to 100%
  estimatedScore      Float     @default(5.0)
  weakTopicsJson      String?   @db.Text // ["Limits", "Integration by parts"]
  studyPlanJson       String?   @db.Text // structured phases and daily tasks
  riskLevel           String    @default("MODERATE") // LOW, MODERATE, HIGH, CRITICAL
  status              String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, examDate])
  @@index([subjectId])
}

model Assignment {
  id                       String    @id @default(cuid())
  userId                   String
  subjectId                String?
  semesterId               String?
  title                    String
  description              String?   @db.Text
  deadline                 DateTime
  priority                 String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  estimatedWorkloadMinutes Int       @default(120)
  status                   String    @default("NOT_STARTED") // NOT_STARTED, PLANNING, IN_PROGRESS, REVIEWING, COMPLETED, SUBMITTED
  progressPercent          Int       @default(0)
  submissionDate           DateTime?
  grade                    Float?
  attachmentsJson          String?   @db.Text
  notes                    String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, deadline])
  @@index([subjectId])
  @@index([semesterId])
}

model KnowledgeNode {
  id           String   @id @default(cuid())
  userId       String
  subjectId    String?
  title        String
  chapter      String?
  topic        String?
  description  String?  @db.Text
  masteryScore Float    @default(0.0) // 0.0 to 1.0
  importance   String   @default("CORE") // CORE, ELECTIVE, ADVANCED
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  prerequisites KnowledgePrerequisite[] @relation("NodePrerequisites")
  dependents    KnowledgePrerequisite[] @relation("PrerequisiteOfNodes")

  @@index([userId])
  @@index([subjectId])
}

model KnowledgePrerequisite {
  id              String   @id @default(cuid())
  nodeId          String
  prerequisiteId  String
  requiredMastery Float    @default(0.6)
  createdAt       DateTime @default(now())

  node         KnowledgeNode @relation("NodePrerequisites", fields: [nodeId], references: [id], onDelete: Cascade)
  prerequisite KnowledgeNode @relation("PrerequisiteOfNodes", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([nodeId, prerequisiteId])
  @@index([nodeId])
  @@index([prerequisiteId])
}

model SyllabusImport {
  id             String   @id @default(cuid())
  userId         String
  subjectId      String?
  rawText        String   @db.Text
  parsedDataJson String   @db.Text
  status         String   @default("PARSED") // PARSED, APPLIED, DISCARDED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subjectId])
}

model BackupRecord {
  id              String   @id @default(cuid())
  userId          String
  version         String   @default("1.0")
  sizeBytes       Int      @default(0)
  modulesIncluded String   // "ALL" or comma-separated list
  checksum        String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ContentVersion {
  id            String   @id @default(cuid())
  userId        String
  entityType    String   // NOTE, ROADMAP, FLASHCARD_DECK
  entityId      String
  versionNumber Int      @default(1)
  snapshotJson  String   @db.Text
  changeSummary String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType, entityId])
}



