datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// USER & AUTHENTICATION
// ==============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER")
  timezone      String    @default("Asia/Ho_Chi_Minh")
  xp            Int       @default(0)
  streakDays    Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  userApiKeys           UserApiKey[]
  subjects              Subject[]
  goals                 Goal[]
  calendarEvents        CalendarEvent[]
  studySessions         StudySession[]
  availabilityRules     AvailabilityRule[]
  aiPreferences         AiPreferences?
  userStudyPreferences UserStudyPreferences?
  userSettings          UserSettings?
  documents             Document[]
  learningRoadmaps      LearningRoadmap[]
  quizzes               Quiz[]
  quizAttempts          QuizAttempt[]
  flashcardDecks        FlashcardDeck[]
  flashcardReviews      FlashcardReview[]
  flashcardStudySessions FlashcardStudySession[]
  resources             Resource[]
  studyNotes            StudyNote[]
  tasks                 Task[]
  dailyTaskSummaries    DailyTaskSummary[]
  notes                 Note[]
  tags                  Tag[]
  habits                Habit[]
  notifications         Notification[]
  weeklyReviews         WeeklyReview[]
  flexibleStudyGoals    FlexibleStudyGoal[]
  dailyGoalProgresses   DailyGoalProgress[]

  // LUYENTU Vocabulary Platform
  coins                 Int       @default(100)
  isPro                 Boolean   @default(false)
  vocabEnrollments      UserCourseEnrollment[]
  vocabSetProgresses    UserWordSetProgress[]
  vocabWordProgresses   UserWordProgress[]
  vocabStudySessions    VocabStudySession[]
  userPurchases         UserPurchase[]
  vocabMasteries        UserVocabularyMastery[]
  learningEvents        LearningEvent[]
  aiLearningReports     UserAiLearningReport[]

  // 4-Year Academic OS Relations
  degreeProgram         DegreeProgram?
  academicYears         AcademicYear[]
  semesters             Semester[]
  skills                Skill[]
  projects              Project[]
  certificates          Certificate[]
  careerApplications    CareerApplication[]
  auditLogs             AuditLog[]

  // 4-Year University Learning OS Master Models
  learningProfile       UserLearningMemory?
  mistakeRecords        MistakeRecord[]
  examPreparations      ExamPreparation[]
  assignments           Assignment[]
  knowledgeNodes        KnowledgeNode[]
  syllabusImports       SyllabusImport[]
  backupRecords         BackupRecord[]
  contentVersions       ContentVersion[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String // GEMINI, OPENAI, ANTHROPIC
  encryptedKey String   @db.Text
  iv           String
  authTag      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ==============================================================================
// USER PREFERENCES & SETTINGS
// ==============================================================================

model UserStudyPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  maxSessionDurationMins  Int      @default(90)
  breakDurationMins       Int      @default(15)
  pomodoroDurationMins    Int      @default(25)
  pomodoroBreakMins       Int      @default(5)
  preferredStudyHours     String   @default("08:00-11:30,14:00-17:30,19:30-22:30")
  unwantedStudyHours      String   @default("23:00-06:00,12:00-13:30")
  maxDailyStudyHours      Float    @default(6.0)
  maxDailySessions        Int      @default(4)
  restDays                String   @default("0") // Day of week: 0 = Sun
  timePreference          String   @default("BALANCED") // MORNING, AFTERNOON, EVENING, BALANCED
  scheduleFlexibility     String   @default("MODERATE") // STRICT, MODERATE, FLEXIBLE
  minBreakBetweenSessions Int      @default(15)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiPreferences {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  preferredStudyDuration Int      @default(90)
  preferredBreakDuration Int      @default(15)
  preferredStudyDays     String   @default("1,2,3,4,5,6,0")
  preferredTimeRanges    String   @default("14:00-17:00,19:00-22:30")
  maxDailyStudyHours     Float    @default(6.0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  timezone               String   @default("Asia/Ho_Chi_Minh")
  weekStartDay           Int      @default(1)
  language               String   @default("vi")
  weeklyStudyBudgetHours Float    @default(20.0)
  examMode               Boolean  @default(false)
  notificationsEnabled   Boolean  @default(true)
  autoShareResources     Boolean  @default(false)
  remindMissingResources Boolean  @default(true)
  autoDayClosureEnabled   Boolean  @default(false)
  autoRolloverTasksEnabled Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==============================================================================
// SUBJECTS, GOALS & MILESTONES
// ==============================================================================

model Subject {
  id                String    @id @default(cuid())
  userId            String
  name              String
  code              String?
  color             String    @default("#408257")
  description       String?   @db.Text
  targetHours       Float?
  completedHours    Float     @default(0.0)
  priority          Int       @default(3)
  targetScore       String?
  deadline          DateTime?
  difficulty        String    @default("MEDIUM") // EASY, MEDIUM, HARD
  estimatedWorkload Float?
  isArchived        Boolean   @default(false)

  // 4-Year Academic Extensions
  semesterId        String?
  credits           Int       @default(3)
  lecturer          String?
  classroom         String?
  syllabus          String?   @db.Text
  status            String    @default("ACTIVE") // PLANNED, ACTIVE, COMPLETED, DROPPED, ARCHIVED
  midtermScore      Float?
  finalScore        Float?
  courseGrade       Float?    // 10.0 scale
  letterGrade       String?   // A, B+, B, C+, C, D+, D, F
  gradePoints       Float?    // 4.0 scale
  gradeWeightJson   String?   @db.Text // {"attendance":10,"midterm":30,"project":20,"final":40}
  attendanceCount   Int       @default(0)
  totalSessions     Int       @default(15)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester         Semester?         @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  goals            Goal[]
  calendarEvents   CalendarEvent[]
  studySessions    StudySession[]
  documents        Document[]
  learningRoadmaps LearningRoadmap[]
  quizzes          Quiz[]
  flashcardDecks   FlashcardDeck[]
  resources        Resource[]
  studyNotes       StudyNote[]
  tasks            Task[]
  notes            Note[]
  habits           Habit[]
  projects         Project[]
  assignments      Assignment[]
  mistakeRecords   MistakeRecord[]
  examPreparations ExamPreparation[]
  knowledgeNodes   KnowledgeNode[]
  syllabusImports  SyllabusImport[]
  vocabCourses     VocabCourse[]
  wordSets         WordSet[]
  vocabWords       VocabWord[]
  vocabStudySessions VocabStudySession[]
  flexibleGoals    FlexibleStudyGoal[]

  @@index([userId])
  @@index([semesterId])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  subjectId   String?
  title       String
  description String?   @db.Text
  targetHours Float
  deadline    DateTime?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  milestones  String?   @db.Text // Legacy JSON milestones
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject          Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  milestoneRecords Milestone[]
  tasks            Task[]
  studySessions    StudySession[]
  calendarEvents   CalendarEvent[]
  notes            Note[]

  @@index([userId])
  @@index([subjectId])
}

model Milestone {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  description String?   @db.Text
  targetDate  DateTime?
  isCompleted Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal  Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([goalId])
}

// ==============================================================================
// TASK SYSTEM & DEPENDENCIES (TODOIST-STYLE INBOX & DAG)
// ==============================================================================

model Task {
  id                 String    @id @default(cuid())
  userId             String
  subjectId          String?
  goalId             String?
  milestoneId        String?
  parentTaskId       String?
  title              String
  description        String?   @db.Text
  priority           String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  deadline           DateTime?
  estimatedMinutes   Int       @default(60)
  status             String    @default("INBOX") // INBOX, TODO, IN_PROGRESS, DONE, CANCELLED
  isRecurring        Boolean   @default(false)
  recurrenceRule     String?
  scheduledStartTime DateTime?
  scheduledEndTime   DateTime?
  order              Int       @default(0)
  isCompleted        Boolean   @default(false)
  completedAt        DateTime?
  scheduledDate      String?   // "YYYY-MM-DD" in user timezone
  originalDate       String?   // "YYYY-MM-DD" initial assigned date
  isImportant        Boolean   @default(false)
  isRollover         Boolean   @default(false)
  rolloverCount      Int       @default(0)
  lastRolloverAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject          Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  goal             Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestone        Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parentTask       Task?            @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks         Task[]           @relation("SubTasks")
  dependencies     TaskDependency[] @relation("TaskRequires")
  prerequisitesFor TaskDependency[] @relation("PrerequisiteOf")
  studySessions    StudySession[]
  calendarEvents   CalendarEvent[]
  tags             TaskTag[]
  notes            Note[]

  @@index([userId, status])
  @@index([userId, scheduledDate])
  @@index([userId, isImportant])
  @@index([userId, isCompleted])
  @@index([subjectId])
  @@index([goalId])
  @@index([milestoneId])
}

model DailyTaskSummary {
  id               String    @id @default(cuid())
  userId           String
  dateKey          String    // "YYYY-MM-DD" in user timezone
  totalTasks       Int       @default(0)
  completedTasks   Int       @default(0)
  uncompletedTasks Int       @default(0)
  completionRate   Float     @default(0.0) // 0.0 - 100.0%
  rolledOverTasks  Int       @default(0)
  isClosed         Boolean   @default(false)
  closedAt         DateTime?
  snapshotData     String?   @db.Text // JSON snapshot of tasks at closure time { tasks: [...] }
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId, dateKey])
  @@index([userId, isClosed])
}

model TaskDependency {
  id             String   @id @default(cuid())
  taskId         String
  prerequisiteId String
  createdAt      DateTime @default(now())

  task         Task @relation("TaskRequires", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisite Task @relation("PrerequisiteOf", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([taskId, prerequisiteId])
  @@index([taskId])
  @@index([prerequisiteId])
}

// ==============================================================================
// CALENDAR & AVAILABILITY
// ==============================================================================

model CalendarEvent {
  id            String   @id @default(cuid())
  userId        String
  subjectId     String?
  taskId        String?
  skillId       String?
  skillTaskId   String?
  title         String
  description   String?  @db.Text
  startTime     DateTime
  endTime       DateTime
  timezone      String   @default("Asia/Ho_Chi_Minh")
  type          String   @default("OTHER") // SCHOOL, SELF_STUDY, PERSONAL, EXAM, DEADLINE, OTHER (also supports legacy STUDY, MEETING, BLOCKED)
  location      String?  @db.Text
  isLocked      Boolean  @default(false)
  isFlexible    Boolean  @default(false)
  isAllDay      Boolean  @default(false)
  trackStudyTime Boolean @default(true)
  isAiGenerated Boolean  @default(false)

  // Scheduling mode & Flexible Goal link
  schedulingMode String   @default("FIXED") // FIXED, FLEXIBLE
  preferredPeriod String? // MORNING, AFTERNOON, EVENING, ANY
  flexibleGoalId String?

  // Recurring support
  seriesId       String?
  recurrence     String          @default("NONE") // NONE, DAILY, WEEKLY, MONTHLY, YEARLY
  recurrenceRule String?         @db.Text
  recurrenceEnd  DateTime?
  parentId       String?
  exceptionDate  String?
  isException    Boolean         @default(false)
  isCancelled    Boolean         @default(false)

  goalId        String?

  // Completion & Actual Time Tracking
  completed              Boolean         @default(false)
  completedAt            DateTime?
  actualDurationMinutes  Int?
  plannedDurationMinutes Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  task          Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal          Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  skill         Skill?          @relation(fields: [skillId], references: [id], onDelete: SetNull)
  skillTask     SkillTask?      @relation(fields: [skillTaskId], references: [id], onDelete: SetNull)
  studySessions StudySession[]
  flexibleGoal  FlexibleStudyGoal? @relation(fields: [flexibleGoalId], references: [id], onDelete: SetNull)
  parent        CalendarEvent?  @relation("EventExceptions", fields: [parentId], references: [id], onDelete: Cascade)
  exceptions    CalendarEvent[] @relation("EventExceptions")
  resources     Resource[]
  studyNotes    StudyNote[]

  @@index([userId, startTime, endTime])
  @@index([userId, subjectId])
  @@index([userId, completed])
  @@index([parentId])
  @@index([taskId])
  @@index([goalId])
  @@index([flexibleGoalId])
}

model AvailabilityRule {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("Giờ rảnh")
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  timezone    String   @default("Asia/Ho_Chi_Minh")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

// ==============================================================================
// STUDY SESSIONS & TRACKING
// ==============================================================================

model StudySession {
  id                     String    @id @default(cuid())
  userId                 String
  subjectId              String?
  skillId                String?
  skillTaskId            String?
  calendarEventId        String?
  taskId                 String?
  goalId                 String?
  flexibleGoalId         String?
  plannedStart           DateTime?
  plannedEnd             DateTime?
  actualStart            DateTime
  actualEnd              DateTime
  plannedDurationSeconds Int?
  actualDurationSeconds  Int
  status                 String    @default("COMPLETED") // PLANNED, IN_PROGRESS, COMPLETED, PARTIAL, MISSED, CANCELLED
  notes                  String?   @db.Text
  productivityScore      Int?
  interruptionsCount     Int       @default(0)
  source                 String    @default("PIP_TIMER") // CALENDAR_CHECKBOX, PIP_TIMER, MANUAL
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  skill         Skill?         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillTask     SkillTask?     @relation(fields: [skillTaskId], references: [id], onDelete: SetNull)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  flexibleGoal  FlexibleStudyGoal? @relation(fields: [flexibleGoalId], references: [id], onDelete: SetNull)

  @@index([userId, actualStart])
  @@index([userId, subjectId])
  @@index([skillId])
  @@index([calendarEventId])
  @@index([taskId])
  @@index([goalId])
  @@index([flexibleGoalId])
}

// ==============================================================================
// LEARNING MATERIALS, ROADMAPS & QUIZZES
// ==============================================================================

model Document {
  id            String   @id @default(cuid())
  userId        String
  subjectId     String?
  filename      String
  fileSize      Int
  fileType      String   @default("application/pdf")
  storagePath   String?
  extractedText String?  @db.Text
  pageCount     Int      @default(1)
  contentHash   String?
  status        String   @default("READY")
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject          Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  learningRoadmaps LearningRoadmap[]
  quizzes          Quiz[]
  notes            Note[]

  @@index([userId])
}

model LearningRoadmap {
  id              String   @id @default(cuid())
  userId          String
  subjectId       String?
  documentId      String?
  title           String
  targetDays      Int      @default(14)
  targetGrade     String   @default("A")
  dailyMinutes    Int      @default(25)
  totalStages     Int      @default(0)
  completedStages Int      @default(0)
  totalXp         Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  document Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  stages   RoadmapStage[]

  @@index([userId])
}

model RoadmapStage {
  id               String   @id @default(cuid())
  roadmapId        String
  dayNumber        Int
  title            String
  description      String?  @db.Text
  estimatedMinutes Int      @default(15)
  xpReward         Int      @default(100)
  isUnlocked       Boolean  @default(false)
  isCompleted      Boolean  @default(false)
  lessonContent    String?  @db.Text
  keyConcepts      String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  roadmap        LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  quizzes        Quiz[]
  flashcardDecks FlashcardDeck[]

  @@index([roadmapId, dayNumber])
}

model Quiz {
  id            String   @id @default(cuid())
  userId        String
  stageId       String?
  documentId    String?
  subjectId     String?
  title         String
  description   String?  @db.Text
  difficulty    String   @default("MEDIUM")
  questionCount Int      @default(10)
  status        String   @default("PUBLISHED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     RoadmapStage?  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  document  Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([userId])
  @@index([stageId])
}

model QuizQuestion {
  id              String   @id @default(cuid())
  quizId          String
  question        String   @db.Text
  options         String   @db.Text
  correctAnswer   Int
  hint            String?  @db.Text
  rationale       String   @db.Text
  difficulty      String   @default("MEDIUM")
  questionType    String   @default("APPLICATION")
  topic           String
  sourceReference String?
  sourcePage      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId])
}

model QuizAttempt {
  id               String    @id @default(cuid())
  userId           String
  quizId           String
  mode             String    @default("PRACTICE")
  score            Float
  totalQuestions   Int
  correctAnswers   Int
  incorrectAnswers Int
  skippedQuestions Int       @default(0)
  timeSpentSeconds Int
  xpEarned         Int       @default(0)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([userId, quizId])
}

model QuizAnswer {
  id               String  @id @default(cuid())
  attemptId        String
  questionId       String
  selectedAnswer   Int
  isCorrect        Boolean
  timeSpentSeconds Int     @default(0)

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

// ==============================================================================
// FLASHCARDS & SPACED REPETITION (ANKI SM-2)
// ==============================================================================

model FlashcardDeck {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String?
  stageId     String?
  title       String
  description String?  @db.Text
  cardCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  stage         RoadmapStage?           @relation(fields: [stageId], references: [id], onDelete: SetNull)
  flashcards    Flashcard[]
  studySessions FlashcardStudySession[]

  @@index([userId])
}

model Flashcard {
  id              String    @id @default(cuid())
  deckId          String
  front           String    @db.Text
  back            String    @db.Text
  hint            String?   @db.Text
  topic           String?
  sourceReference String?
  masteryLevel    Int       @default(0) // 0 to 5
  intervalDays    Int       @default(1)
  easeFactor      Float     @default(2.5)
  repetitionCount Int       @default(0)
  status          String    @default("NEW") // NEW, LEARNING, REVIEW, MASTERED
  lastReviewed    DateTime?
  nextReview      DateTime?

  // Rich metadata for language learning & study modes
  phonetic        String?
  partOfSpeech    String?
  exampleSentence String?   @db.Text
  exampleMeaning  String?   @db.Text
  imageUrl        String?
  audioUrl        String?
  correctCount    Int       @default(0)
  incorrectCount  Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  deck            FlashcardDeck            @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews         FlashcardReview[]
  studyQuestions  FlashcardStudyQuestion[]

  @@index([deckId])
  @@index([status, nextReview])
}

model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  flashcardId  String
  rating       Int // 1: Again, 2: Hard, 3: Good, 4: Easy
  intervalDays Int
  easeFactor   Float
  reviewedAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([userId, flashcardId])
}

model FlashcardStudySession {
  id              String                   @id @default(cuid())
  userId          String
  deckId          String
  mode            String                   @default("ALL") // ALL, FLASHCARD, QUIZ, LISTENING, TYPING, MATCHING
  startedAt       DateTime                 @default(now())
  completedAt     DateTime?
  totalQuestions  Int                      @default(0)
  correctAnswers  Int                      @default(0)
  wrongAnswers    Int                      @default(0)
  accuracy        Float                    @default(0)
  durationSeconds Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck            FlashcardDeck            @relation(fields: [deckId], references: [id], onDelete: Cascade)
  questions       FlashcardStudyQuestion[]

  @@index([userId, deckId])
  @@index([userId, startedAt])
}

model FlashcardStudyQuestion {
  id             String                @id @default(cuid())
  sessionId      String
  cardId         String
  questionType   String                // FLASHCARD, EN_TO_VI, VI_TO_EN, CONTEXT_IMAGE, LISTENING_TYPING, EN_TYPING_VI, VI_TYPING_EN, MATCHING
  question       String                @db.Text
  userAnswer     String?               @db.Text
  correctAnswer  String                @db.Text
  isCorrect      Boolean
  responseTimeMs Int                   @default(0)
  createdAt      DateTime              @default(now())

  session        FlashcardStudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  card           Flashcard             @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([cardId])
}

// ==============================================================================
// NOTION-STYLE NOTES & KNOWLEDGE BASE
// ==============================================================================

model Note {
  id         String   @id @default(cuid())
  userId     String
  subjectId  String?
  goalId     String?
  taskId     String?
  documentId String?
  title      String   @default("Ghi chú mới")
  content    String   @db.Text
  isPinned   Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  goal     Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  tags     NoteTag[]

  @@index([userId])
  @@index([subjectId])
}

// ==============================================================================
// TAG SYSTEM (#Tags)
// ==============================================================================

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#408257")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags TaskTag[]
  noteTags NoteTag[]

  @@unique([userId, name])
  @@index([userId])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

// ==============================================================================
// HABIT TRACKER
// ==============================================================================

model Habit {
  id            String     @id @default(cuid())
  userId        String
  subjectId     String?
  title         String
  description   String?
  frequency     String     @default("DAILY") // DAILY, WEEKLY
  targetDays    String     @default("1,2,3,4,5,6,0")
  targetValue   Int        @default(1)
  unit          String     @default("lần")
  color         String     @default("#2d6a4f")
  icon          String     @default("Check")
  streak        Int        @default(0)
  longestStreak Int        @default(0)
  isArchived    Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  habitLogs HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  dateKey   String   // "YYYY-MM-DD" in Asia/Ho_Chi_Minh
  value     Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, dateKey])
  @@index([habitId])
}

// ==============================================================================
// SMART NOTIFICATIONS
// ==============================================================================

model Notification {
  id           String    @id @default(cuid())
  userId       String
  title        String
  message      String
  type         String    // SESSION_REMINDER, DEADLINE, EXAM, MISSED_SESSION, STREAK, UNFINISHED_TASK
  isRead       Boolean   @default(false)
  link         String?
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ==============================================================================
// AI WEEKLY REVIEW & CATCH-UP
// ==============================================================================

model WeeklyReview {
  id                String   @id @default(cuid())
  userId            String
  weekStartDate     String   // "YYYY-MM-DD"
  weekEndDate       String   // "YYYY-MM-DD"
  plannedHours      Float    @default(0.0)
  actualHours       Float    @default(0.0)
  completionRate    Float    @default(0.0)
  completedGoals    Int      @default(0)
  totalGoals        Int      @default(0)
  upcomingDeadlines Int      @default(0)
  subjectStatsJson  String   @db.Text
  aiInsightsJson    String   @db.Text
  nextWeekPlanJson  String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

