datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String         @default("USER")
  timezone      String         @default("Asia/Ho_Chi_Minh")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts          Account[]
  sessions          Session[]
  userApiKeys       UserApiKey[]
  subjects          Subject[]
  goals             Goal[]
  calendarEvents    CalendarEvent[]
  studySessions     StudySession[]
  availabilityRules AvailabilityRule[]
  aiPreferences     AiPreferences?
  userSettings      UserSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // GEMINI, OPENAI, ANTHROPIC
  encryptedKey String   @db.Text
  iv           String
  authTag      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider])
}

model Subject {
  id             String   @id @default(cuid())
  userId         String
  name           String
  code           String?
  color          String   @default("#408257")
  description    String?  @db.Text
  targetHours    Float    @default(10.0)
  completedHours Float    @default(0.0)
  priority       Int      @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals          Goal[]
  calendarEvents CalendarEvent[]
  studySessions  StudySession[]

  @@index([userId])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  subjectId   String?
  title       String
  description String?   @db.Text
  targetHours Float
  deadline    DateTime?
  status      String    @default("ACTIVE")
  milestones  String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  userId        String
  subjectId     String?
  title         String
  description   String?   @db.Text
  startTime     DateTime
  endTime       DateTime
  timezone      String    @default("Asia/Ho_Chi_Minh")
  type          String    @default("STUDY")
  isLocked      Boolean   @default(false)
  isAiGenerated Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  studySessions StudySession[]

  @@index([userId, startTime, endTime])
}

model StudySession {
  id                    String         @id @default(cuid())
  userId                String
  subjectId             String
  calendarEventId       String?
  plannedStart          DateTime?
  plannedEnd            DateTime?
  actualStart           DateTime
  actualEnd             DateTime
  actualDurationSeconds Int
  status                String         @default("COMPLETED")
  notes                 String?        @db.Text
  productivityScore     Int?
  source                String         @default("PIP_TIMER")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)

  @@index([userId, actualStart])
}

model AvailabilityRule {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("Giờ rảnh")
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  timezone    String   @default("Asia/Ho_Chi_Minh")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model AiPreferences {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  preferredStudyDuration Int      @default(90)
  preferredBreakDuration Int      @default(15)
  preferredStudyDays     String   @default("1,2,3,4,5,6,0")
  preferredTimeRanges    String   @default("14:00-17:00,19:00-22:30")
  maxDailyStudyHours     Float    @default(6.0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  timezone               String   @default("Asia/Ho_Chi_Minh")
  weekStartDay           Int      @default(1)
  language               String   @default("vi")
  weeklyStudyBudgetHours Float    @default(20.0)
  examMode               Boolean  @default(false)
  notificationsEnabled   Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
