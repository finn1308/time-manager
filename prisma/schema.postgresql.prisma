datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String         @default("USER")
  timezone      String         @default("Asia/Ho_Chi_Minh")
  xp            Int            @default(0)
  streakDays    Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts          Account[]
  sessions          Session[]
  userApiKeys       UserApiKey[]
  subjects          Subject[]
  goals             Goal[]
  calendarEvents    CalendarEvent[]
  studySessions     StudySession[]
  availabilityRules AvailabilityRule[]
  aiPreferences     AiPreferences?
  userSettings      UserSettings?
  documents         Document[]
  learningRoadmaps  LearningRoadmap[]
  quizzes           Quiz[]
  quizAttempts      QuizAttempt[]
  flashcardDecks    FlashcardDeck[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // GEMINI, OPENAI, ANTHROPIC
  encryptedKey String   @db.Text
  iv           String
  authTag      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider])
}

model Subject {
  id             String   @id @default(cuid())
  userId         String
  name           String
  code           String?
  color          String   @default("#408257")
  description    String?  @db.Text
  targetHours    Float    @default(10.0)
  completedHours Float    @default(0.0)
  priority       Int      @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals            Goal[]
  calendarEvents   CalendarEvent[]
  studySessions    StudySession[]
  documents        Document[]
  learningRoadmaps LearningRoadmap[]
  quizzes          Quiz[]
  flashcardDecks   FlashcardDeck[]

  @@index([userId])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  subjectId   String?
  title       String
  description String?   @db.Text
  targetHours Float
  deadline    DateTime?
  status      String    @default("ACTIVE")
  milestones  String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  userId        String
  subjectId     String?
  title         String
  description   String?   @db.Text
  startTime     DateTime
  endTime       DateTime
  timezone      String    @default("Asia/Ho_Chi_Minh")
  type          String    @default("STUDY")
  isLocked      Boolean   @default(false)
  isAiGenerated Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  studySessions StudySession[]

  @@index([userId, startTime, endTime])
}

model StudySession {
  id                    String         @id @default(cuid())
  userId                String
  subjectId             String
  calendarEventId       String?
  plannedStart          DateTime?
  plannedEnd            DateTime?
  actualStart           DateTime
  actualEnd             DateTime
  actualDurationSeconds Int
  status                String         @default("COMPLETED")
  notes                 String?        @db.Text
  productivityScore     Int?
  source                String         @default("PIP_TIMER")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)

  @@index([userId, actualStart])
}

model AvailabilityRule {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("Giờ rảnh")
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  timezone    String   @default("Asia/Ho_Chi_Minh")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model AiPreferences {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  preferredStudyDuration Int      @default(90)
  preferredBreakDuration Int      @default(15)
  preferredStudyDays     String   @default("1,2,3,4,5,6,0")
  preferredTimeRanges    String   @default("14:00-17:00,19:00-22:30")
  maxDailyStudyHours     Float    @default(6.0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  timezone               String   @default("Asia/Ho_Chi_Minh")
  weekStartDay           Int      @default(1)
  language               String   @default("vi")
  weeklyStudyBudgetHours Float    @default(20.0)
  examMode               Boolean  @default(false)
  notificationsEnabled   Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==============================================================================
// AI QUIZ & LEARNING ROADMAP GENERATOR ("STUDY BUNNY / STUDY QUEST")
// ==============================================================================

model Document {
  id            String         @id @default(cuid())
  userId        String
  subjectId     String?
  filename      String
  fileSize      Int
  fileType      String         @default("application/pdf")
  storagePath   String?
  extractedText String?        @db.Text
  pageCount     Int            @default(1)
  contentHash   String?
  status        String         @default("READY") // UPLOADING, PROCESSING, EXTRACTING, ANALYZING, GENERATING, READY, FAILED
  errorMessage  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject          Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  learningRoadmaps LearningRoadmap[]
  quizzes          Quiz[]

  @@index([userId])
}

model LearningRoadmap {
  id              String         @id @default(cuid())
  userId          String
  subjectId       String?
  documentId      String?
  title           String
  targetDays      Int            @default(14) // 7, 14, 21, 30, or custom
  targetGrade     String         @default("A") // PASS, C, C+, B, B+, A, A+
  dailyMinutes    Int            @default(25)
  totalStages     Int            @default(0)
  completedStages Int            @default(0)
  totalXp         Int            @default(0)
  status          String         @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  document  Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  stages    RoadmapStage[]

  @@index([userId])
}

model RoadmapStage {
  id               String         @id @default(cuid())
  roadmapId        String
  dayNumber        Int            // Day 1, Day 2, Day 3...
  title            String         // e.g. "Chương 1: Tổng quan về Quản trị Bán hàng"
  description      String?        @db.Text
  estimatedMinutes Int            @default(15)
  xpReward         Int            @default(100)
  isUnlocked       Boolean        @default(false)
  isCompleted      Boolean        @default(false)
  lessonContent    String?        @db.Text // Key concepts, summary, bullet points
  keyConcepts      String?        @db.Text // JSON string array
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  roadmap        LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  quizzes        Quiz[]
  flashcardDecks FlashcardDeck[]

  @@index([roadmapId, dayNumber])
}

model Quiz {
  id            String         @id @default(cuid())
  userId        String
  stageId       String?
  documentId    String?
  subjectId     String?
  title         String
  description   String?        @db.Text
  difficulty    String         @default("MEDIUM") // EASY, MEDIUM, HARD, MIXED
  questionCount Int            @default(10)
  status        String         @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage         RoadmapStage?  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions     QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([userId])
  @@index([stageId])
}

model QuizQuestion {
  id              String       @id @default(cuid())
  quizId          String
  question        String       @db.Text
  options         String       @db.Text // JSON array: ["A", "B", "C", "D"]
  correctAnswer   Int          // 0, 1, 2, 3
  hint            String?      @db.Text
  rationale       String       @db.Text
  difficulty      String       @default("MEDIUM")
  questionType    String       @default("APPLICATION") // APPLICATION, SCENARIO, ANALYSIS, CAUSE_EFFECT, CONCEPT
  topic           String
  sourceReference String?      // e.g. "Chương 2, Mục 3"
  sourcePage      Int?         // e.g. 17
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId])
}

model QuizAttempt {
  id                String       @id @default(cuid())
  userId            String
  quizId            String
  mode              String       @default("PRACTICE") // PRACTICE, EXAM
  score             Float        // Percentage 0-100
  totalQuestions    Int
  correctAnswers    Int
  incorrectAnswers  Int
  skippedQuestions  Int          @default(0)
  timeSpentSeconds  Int
  xpEarned          Int          @default(0)
  startedAt         DateTime     @default(now())
  completedAt       DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([userId, quizId])
}

model QuizAnswer {
  id               String       @id @default(cuid())
  attemptId        String
  questionId       String
  selectedAnswer   Int          // 0, 1, 2, 3 (-1 if skipped)
  isCorrect        Boolean
  timeSpentSeconds Int          @default(0)

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model FlashcardDeck {
  id          String      @id @default(cuid())
  userId      String
  subjectId   String?
  stageId     String?
  title       String
  description String?     @db.Text
  cardCount   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  stage      RoadmapStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  flashcards Flashcard[]

  @@index([userId])
}

model Flashcard {
  id              String        @id @default(cuid())
  deckId          String
  front           String        @db.Text
  back            String        @db.Text
  hint            String?       @db.Text
  topic           String?
  sourceReference String?
  masteryLevel    Int           @default(0) // 0 to 5
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId])
}
