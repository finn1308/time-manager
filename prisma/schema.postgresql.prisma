// PostgreSQL / Supabase Schema for Production Deployment
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum EventType {
  STUDY
  BUSY_BLOCKED
  FIXED_CLASS
  PERSONAL
}

enum AIProvider {
  OPENAI
  GEMINI
  ANTHROPIC
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role           @default(USER)
  timezone      String         @default("Asia/Ho_Chi_Minh")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts      Account[]
  sessions      Session[]
  userApiKeys   UserApiKey[]
  subjects      Subject[]
  studyGoals    StudyGoal[]
  schedules     ScheduleEvent[]
  studyLogs     StudyLog[]
  blockedSlots  BlockedSlot[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserApiKey {
  id             String     @id @default(cuid())
  userId         String
  provider       AIProvider
  encryptedKey   String     @db.Text
  iv             String
  authTag        String
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider])
}

model Subject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  code        String?
  color       String   @default("#3b82f6")
  icon        String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGoals  StudyGoal[]
  schedules   ScheduleEvent[]
  studyLogs   StudyLog[]
}

model StudyGoal {
  id           String    @id @default(cuid())
  userId       String
  subjectId    String
  targetHours  Float
  startDate    DateTime
  endDate      DateTime
  isAutoAlloc  Boolean   @default(true)
  priority     Int       @default(1)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model BlockedSlot {
  id           String    @id @default(cuid())
  userId       String
  title        String
  startTime    String
  endTime      String
  dayOfWeek    Int?
  specificDate DateTime?
  isRecurring  Boolean   @default(true)
  isLocked     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduleEvent {
  id            String    @id @default(cuid())
  userId        String
  subjectId     String?
  title         String
  description   String?   @db.Text
  startTime     DateTime
  endTime       DateTime
  eventType     EventType @default(STUDY)
  isAiGenerated Boolean   @default(false)
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  studyLogs StudyLog[]
}

model StudyLog {
  id                String         @id @default(cuid())
  userId            String
  subjectId         String
  scheduleEventId   String?
  startTime         DateTime
  endTime           DateTime
  durationMinutes   Int
  notes             String?        @db.Text
  productivityScore Int?
  source            String         @default("PIP_TIMER")
  createdAt         DateTime       @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scheduleEvent ScheduleEvent? @relation(fields: [scheduleEventId], references: [id], onDelete: SetNull)
}
